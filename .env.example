# Copy to .env and edit. Every value has a safe default; nothing here is required to run ORION.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# "live" (default) polls the public sources listed in docs/RESEARCH.md; "offline" runs the synthetic
# scenario only, with no outbound network calls at all. Back-compat: ENABLE_LIVE_FEEDS=false == offline.
ORION_MODE=live

# Per-source on/off switches, e.g. ENABLE_ADSB=false, ENABLE_DIGITRAFFIC=false, ENABLE_OPENSKY=true.
# Every adapter is on by default in live mode except OpenSky (see docs/RESEARCH.md for why).

# Optional credentials — every adapter that supports them also works anonymously, just at a slower cadence.
NVD_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: your own token from https://ion.cesium.com enables Cesium World Terrain and OSM Buildings
# in the client. Without it the globe still renders in full detail on Natural Earth + NASA GIBS imagery.
CESIUM_ION_TOKEN=

# Advanced
# ORION_ALLOWED_HOSTS=orion.example.com   # extra Host headers to accept behind a reverse proxy
# RATE_LIMIT_API_PER_MIN=600
# RATE_LIMIT_RECON_PER_MIN=12
# ADSB_PROVIDERS=airplanes.live,adsb.lol,adsb.one
# CELESTRAK_GROUPS=stations,visual,gps-ops,weather,science,geo,military
# USGS_FEED=all_day                       # any feed name from earthquake.usgs.gov/earthquakes/feed/v1.0/
